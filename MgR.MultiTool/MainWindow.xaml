<Window x:Class="MgR.MultiTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MgR multi-tool"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#171A21"
        Foreground="#F1F3F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#6658D3"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#1D222C"/>
        <SolidColorBrush x:Key="CardBrush" Color="#222733"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AEB6C5"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D5D9E2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303646"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Barre de défilement au thème MgR -->
    <Style x:Key="MgRScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="#1D222C"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Opacity="0"
                                        Focusable="False"/>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                        Background="#484F60"
                                                        CornerRadius="5"
                                                        Margin="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#6658D3"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging"
                                                             Value="True">
                                                    <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#8275F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Opacity="0"
                                        Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale MgR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="#303541"
                BorderThickness="0,0,1,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          IsDeferredScrollingEnabled="False">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                        BasedOn="{StaticResource MgRScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel Margin="16">

                    <!-- Identité MgR -->
                    <Border Background="{StaticResource AccentBrush}"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,4,0,22">
                        <StackPanel>
                            <TextBlock Text="MgR"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="MULTI-TOOL"
                                       FontSize="11"
                                       Foreground="#E4E1FF"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Accueil : bouton indépendant -->
                    <Button Content="⌂   Accueil"
                            Style="{StaticResource NavButton}"
                            Click="Home_Click"
                            Margin="0,0,0,12"/>

                    <!-- Windows -->
                    <Expander IsExpanded="True"
                              Foreground="{StaticResource MutedBrush}"
                              Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="WINDOWS"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Expander.Header>

                        <StackPanel Margin="0,6,0,0">
                            <Button Content="▦   Applications"
                                    Style="{StaticResource NavButton}"
                                    Click="Applications_Click"/>

                            <Button Content="◈   Confidentialité"
                                    Style="{StaticResource NavButton}"
                                    Click="Privacy_Click"/>

                            <Button Content="◇   Sécurité"
                                    Style="{StaticResource NavButton}"
                                    Click="Security_Click"/>

                            <Button Content="⚙   Optimisation"
                                    Style="{StaticResource NavButton}"
                                    Click="Optimization_Click"/>

                            <Button Content="▤   Fichiers"
                                    Style="{StaticResource NavButton}"
                                    Click="Files_Click"/>

                            <Button Content="⌑   Permissions"
                                    Style="{StaticResource NavButton}"
                                    Click="Permissions_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- Utilitaires -->
                    <Expander IsExpanded="True"
                              Foreground="{StaticResource MutedBrush}"
                              Margin="0,0,0,8">
                        <Expander.Header>
                            <TextBlock Text="UTILITAIRES"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Expander.Header>

                        <StackPanel Margin="0,6,0,0">
                            <Button Content="⇄   Convertisseurs"
                                    Style="{StaticResource NavButton}"
                                    Click="Converters_Click"/>

                            <Button Content="⌕   Ressources binaires"
                                    Style="{StaticResource NavButton}"
                                    Click="Binary_Click"/>

                            <Button Content="▣   OnePack"
                                    Style="{StaticResource NavButton}"
                                    Click="OnePack_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- Séparateur avant les options de l'application -->
                    <Separator Background="#353A46"
           Margin="0,12,0,10"/>

                    <!-- Historique : bouton indépendant -->
                    <Button Content="◷   Historique"
                            Style="{StaticResource NavButton}"
                            Click="History_Click"/>

                    <!-- Paramètres : bouton indépendant -->
                    <Button Content="⚙   Paramètres"
                            Style="{StaticResource NavButton}"
                            Click="Settings_Click"/>

                    <TextBlock Text="BETA 0.1.0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="8,14,0,8"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="PageTitle"
                           Text="Accueil"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="PageDescription"
                           Text="Tous tes outils au même endroit."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          IsDeferredScrollingEnabled="False">

                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource MgRScrollBar}"/>
                </ScrollViewer.Resources>

                <ContentControl x:Name="MainContent"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
